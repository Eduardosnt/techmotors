# ═══════════════════════════════════════════
# TechMotors — Variáveis de Ambiente
# ═══════════════════════════════════════════
# Copie este arquivo para .env e preencha

# Porta do servidor (padrão: 3000)
PORT=3000

# Chave secreta para geração de tokens JWT
# Em produção, use uma string longa e aleatória
JWT_SECRET=sua_chave_secreta_muito_longa_e_aleatoria_aqui

# Configuração de e-mail (recuperação de senha)
# Para Gmail: https://myaccount.google.com/apppasswords
EMAIL_USER=seu.email@gmail.com
EMAIL_PASS=sua-senha-de-app-16-chars

# CORS - origem permitida (em produção, coloque o domínio)
CORS_ORIGIN=*
